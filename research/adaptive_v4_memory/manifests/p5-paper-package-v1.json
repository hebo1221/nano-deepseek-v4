  ],
  "rules": {
    "missing_required_evidence": "fail generation; never impute",
    "causal_gate_failure": "bounded-result for the tested causal controller, not a general impossibility claim",
    "offline_oracle": "descriptive target-aware upper bound only; never a causal or deployable method result",
    "legacy_m3_offline_pilot": "negative pilot only; full-pass native probes and replay plans are not online learned-lookahead evidence",
    "single_compatible_model": "bounded-result; require all five natural benchmarks and never relabel as official DeepSeek-V4 evidence",
    "reference_system_matrix": "always bounded-result; serial interleave is not actual concurrency",
    "500k_context_preflight": "one attempt per scale-policy is feasibility-only; any success is bounded and all-terminal failure is a bounded negative result",
    "failed_system_cell": "retain in the primary table and classify production systems coverage as bounded-result",
    "official_resource_blocker": "unverified with exact blocker manifest"
  },
